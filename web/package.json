{
  "name": "@certificate-manager/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "analyze": "ANALYZE=1 vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "api:types": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "api:types:check": "npm run api:types && git diff --exit-code -- src/api/schema.d.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^13.2.0",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}

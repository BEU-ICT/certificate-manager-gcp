# Copy to infra/.env (git-ignored) and fill in. Placeholders containing CHANGE_ME are rejected.
PROJECT_ID=CHANGE_ME            # globally unique GCP project id, e.g. certs-beu-prod
PROJECT_NAME="Certificate Manager"
REGION=us-east1
PUBLIC_BASE_URL=CHANGE_ME      # https://<project>.web.app (CORS origin of the PDF bucket)
BILLING_ACCOUNT_ID=CHANGE_ME    # XXXXXX-XXXXXX-XXXXXX, from `gcloud billing accounts list`
# Budget alert recipients: two or more humans. Notified through Cloud Monitoring email channels.
BUDGET_EMAILS="thedeveloper024@gmail.com CHANGE_ME"
# Owners (at least two humans), granted roles/owner by 01-project.sh
OWNER_EMAILS="thedeveloper024@gmail.com CHANGE_ME"

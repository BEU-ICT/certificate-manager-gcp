{
  "realm": "certificate-manager",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [{ "name": "admin", "description": "Certificate Manager administrator" }]
  },
  "users": [
    {
      "username": "${ONPREM_ADMIN_EMAIL}",
      "email": "${ONPREM_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "${ONPREM_ADMIN_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["admin"]
    }
  ],
  "clients": [
    {
      "clientId": "certificate-manager-web",
      "name": "Certificate Manager web app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${ONPREM_PUBLIC_ORIGIN}/auth/callback"],
      "webOrigins": ["${ONPREM_PUBLIC_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ONPREM_PUBLIC_ORIGIN}/login"
      },
      "defaultClientScopes": ["web-origins", "profile", "email"],
      "protocolMappers": [
        {
          "name": "realm roles in id token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}

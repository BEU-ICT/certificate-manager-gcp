{
  "name": "@certificate-manager/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "template-schema:generate": "tsx scripts/generate-template-config-schema.ts",
    "template-schema:check": "tsx scripts/generate-template-config-schema.ts --check",
    "bench:render": "tsx scripts/bench-render.ts",
    "bench:bulk": "tsx scripts/bench-bulk-issue.ts",
    "template:validate": "tsx scripts/validate-template.ts",
    "template-authoring:generate": "tsx scripts/generate-template-authoring-reference.ts",
    "template-authoring:check": "tsx scripts/generate-template-authoring-reference.ts --check",
    "template-fixtures:generate": "tsx test/fixtures/templates/build.ts",
    "check:document-reference": "node scripts/check-document-reference.mjs",
    "check:module-readmes": "node scripts/check-module-readmes.mjs",
    "check:architecture": "npm run depcruise && npm run check:document-reference",
    "test:architecture": "vitest run test/architecture",
    "test:unit": "vitest run test/unit",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-certificate-manager \"vitest run --config vitest.integration.config.ts\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@google-cloud/tasks": "^7.3.1",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.5.0",
    "fontkit": "^2.0.4",
    "google-auth-library": "^11.3.3",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@napi-rs/canvas": "^1.1.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/svg-to-pdfkit": "^0.1.5",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.35.0",
    "jsqr": "^1.4.0",
    "openapi-types": "^12.1.3",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}

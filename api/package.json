{
  "name": "@certificate-manager/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "check:document-reference": "node scripts/check-document-reference.mjs",
    "check:architecture": "npm run depcruise && npm run check:document-reference",
    "test:architecture": "vitest run test/architecture",
    "test:unit": "vitest run test/unit",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-certificate-manager \"vitest run --config vitest.integration.config.ts\""
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}

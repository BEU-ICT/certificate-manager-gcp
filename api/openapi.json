{
  "components": {
    "schemas": {
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": { "example": "VALIDATION_FAILED", "type": "string" },
              "details": {
                "items": { "$ref": "#/components/schemas/ErrorDetail" },
                "type": "array"
              },
              "message": { "type": "string" },
              "requestId": {
                "description": "Request correlation ID; equals the X-Request-Id header.",
                "type": "string"
              }
            },
            "required": ["code", "message", "requestId"],
            "type": "object"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "message": { "type": "string" },
          "path": {
            "description": "Location of the problem in the request, e.g. items[3].email",
            "type": "string"
          }
        },
        "required": ["path", "message"],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": { "status": { "const": "ok", "type": "string" } },
        "required": ["status"],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Generated from the zod route schemas (api/openapi.json, `npm run openapi:generate`).",
    "title": "Certificate Manager API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/healthz": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            },
            "description": "Service is up"
          },
          "429": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "RATE_LIMITED: retry after the Retry-After header"
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "INTERNAL: unexpected error"
          },
          "503": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "UNAVAILABLE: retry after the Retry-After header"
          }
        },
        "summary": "Liveness probe"
      }
    }
  }

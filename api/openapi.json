{
  "components": {
    "schemas": {
      "AdminMe": {
        "additionalProperties": false,
        "properties": {
          "email": { "type": "string" },
          "features": {
            "additionalProperties": false,
            "description": "Feature flags relevant to the admin UI.",
            "properties": {
              "bulkIssuance": { "type": "boolean" },
              "publicPdfGeneration": { "type": "boolean" }
            },
            "required": ["bulkIssuance", "publicPdfGeneration"],
            "type": "object"
          },
          "role": { "const": "admin", "type": "string" },
          "uid": { "type": "string" }
        },
        "required": ["uid", "email", "role", "features"],
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": { "example": "VALIDATION_FAILED", "type": "string" },
              "details": {
                "items": { "$ref": "#/components/schemas/ErrorDetail" },
                "type": "array"
              },
              "message": { "type": "string" },
              "requestId": {
                "description": "Request correlation ID; equals the X-Request-Id header.",
                "type": "string"
              }
            },
            "required": ["code", "message", "requestId"],
            "type": "object"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "message": { "type": "string" },
          "path": {
            "description": "Location of the problem in the request, e.g. items[3].email",
            "type": "string"
          }
        },
        "required": ["path", "message"],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": { "status": { "const": "ok", "type": "string" } },
        "required": ["status"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "Firebase ID token",
        "description": "Admin routes require a Firebase ID token carrying the `role=admin` claim.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Generated from the zod route schemas (api/openapi.json, `npm run openapi:generate`).",
    "title": "Certificate Manager API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/me": {
      "get": {
        "description": "Requires a Firebase ID token with the `role=admin` claim.",
        "operationId": "getAdminMe",
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AdminMe" } }
            },
            "description": "The authenticated administrator"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "UNAUTHENTICATED: missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "FORBIDDEN: not allowed to perform this action"
          },
          "429": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "RATE_LIMITED: retry after the Retry-After header"
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "INTERNAL: unexpected error"
          },
          "503": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "UNAVAILABLE: retry after the Retry-After header"
          }
        },
        "security": [{ "bearerAuth": [] }],
        "summary": "Current administrator"
      }
    },
    "/internal/healthz": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            },
            "description": "Service is up"
          },
          "429": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "RATE_LIMITED: retry after the Retry-After header"
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "INTERNAL: unexpected error"
          },
          "503": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
            },
            "description": "UNAVAILABLE: retry after the Retry-After header"
          }
        },
        "summary": "Liveness probe"
      }
    }
  }
}

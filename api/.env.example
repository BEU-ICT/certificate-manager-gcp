# Copy to .env for local development (.env is git-ignored). Safe local values: emulators / in-memory.
# Validated by test/unit/config.test.ts. Secrets (EMAIL_API_KEY) come from Secret Manager in production.

# Runtime: development | test | production
NODE_ENV=development
# HTTP port (Cloud Run injects PORT)
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# GCP project ID ("demo-" prefix = Firebase emulator project)
GCP_PROJECT=demo-certificate-manager
# Own base URL (Cloud Tasks audience); https and no trailing slash in production
SERVICE_URL=http://localhost:8080
# Public web app base URL used in certificate links and e-mails
PUBLIC_BASE_URL=http://localhost:5173
# Base URL under which certificate PDFs are served
PDF_PUBLIC_BASE_URL=http://localhost:8080

# Buckets (required when STORAGE_ADAPTER=gcs)
# TEMPLATES_BUCKET=
# PDF_BUCKET=
# Cloud Tasks (required when QUEUE_ADAPTER=cloud-tasks)
# TASKS_QUEUE=
# TASKS_LOCATION=us-east1
# TASKS_INVOKER_SA=

# E-mail address of the first administrator (bootstrap migration)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# E-mail: gmail | brevo
EMAIL_PROVIDER=gmail
# Optional fallback provider; must differ from EMAIL_PROVIDER
# EMAIL_FALLBACK_PROVIDER=brevo
# API key, required when brevo is used (secret: never commit a real value)
# EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=certificates@example.com
EMAIL_FROM_NAME=Certificate Manager
# EMAIL_REPLY_TO=
# Maximum e-mails sent per day
EMAIL_DAILY_CAP=300

# Requests per minute per client
RATE_LIMIT_PUBLIC_PER_MIN=10
# Allowed range 30-100
RATE_LIMIT_ADMIN_PER_MIN=60

# Adapters: firestore | memory
DB_ADAPTER=memory
# gcs | fs | memory
STORAGE_ADAPTER=memory
# cloud-tasks | in-process
QUEUE_ADAPTER=in-process
# firebase
AUTH_PROVIDER=firebase

# Feature flags (true|false|1|0); registry in src/flags.ts, unknown FEATURE_* variables fail boot
# Serve the OpenAPI document (default: false in production, true otherwise)
FEATURE_OPENAPI_ENDPOINT=true
# Bounce processing job (default: false)
FEATURE_BOUNCE_JOB=false
# Use the fallback e-mail provider on failure (default: true)
FEATURE_EMAIL_FALLBACK=true
# Bulk issuance (default: true)
FEATURE_BULK_ISSUANCE=true
# On-demand public PDF generation, kill switch: endpoint answers 503 UNAVAILABLE when off (default: true)
FEATURE_PUBLIC_PDF_GENERATION=true

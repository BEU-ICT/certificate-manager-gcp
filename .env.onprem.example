# On-prem reference stack. Copy to .env.onprem and fill EVERY empty value (no defaults are shipped);
# ./scripts/onprem-init-env.sh does this with random secrets. .env.onprem is git-ignored.

# Public origin of the web app (the TLS port of the nginx container) and of Keycloak, as the BROWSER sees them.
PUBLIC_ORIGIN=https://localhost:8443
KEYCLOAK_PUBLIC_URL=http://localhost:8180
TLS_HOSTNAME=localhost
# Interface for all published ports. Keep 127.0.0.1 unless a firewall/reverse proxy is in front.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8443
KEYCLOAK_PORT=8180
MAILPIT_UI_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432

# Test administrator (created in the Keycloak realm with the `admin` role; also the API bootstrap admin).
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=

POSTGRES_USER=certmgr
POSTGRES_DB=certmgr
POSTGRES_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=minioroot
MINIO_ROOT_PASSWORD=
# Least-privilege MinIO user the API runs as (created by minio-init).
S3_APP_ACCESS_KEY=certmgr-app
S3_APP_SECRET_KEY=

EMAIL_FROM_ADDRESS=certificates@example.test
LOG_LEVEL=info
